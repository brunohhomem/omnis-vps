# Copy to .env. Loaded with node --env-file (no dotenv).

# development | production | test
NODE_ENV=development

# In production, only loopback is accepted unless ALLOW_PUBLIC_BIND=true.
HOST=127.0.0.1
ALLOW_PUBLIC_BIND=false

PORT=4010

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# real uses the host. fake is for development off the VPS.
OMNIS_MODE=fake

# Optional path to the Next.js static export, relative to apps/server.
# Leave unset in dev; next dev serves the web app on its own port.
# WEB_DIST_DIR=../web/out

# Relative to the apps/server working directory. Production: /var/lib/omnis
DATA_DIR=./data
MIGRATIONS_DIR=./drizzle
DB_BACKUPS_KEEP=5

# Comma-separated mount points read with statfs.
DISK_MOUNTS=/

# 32 bytes, base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OMNIS_SECRET_KEY=

# Session cookie lifetime in hours. 168 = 7 days.
SESSION_TTL_HOURS=168

# Set false only for local http. Production stays true.
COOKIE_SECURE=true

# true behind Cloudflare Tunnel, so the client IP comes from cf-connecting-ip.
TRUST_CLOUDFLARE=false

# Comma-separated origins allowed to call /mcp. Empty rejects every Origin header.
# Clients that omit Origin, such as Claude Code, still work.
MCP_ALLOWED_ORIGINS=
